<Window x:Class="CodexQuotaMonitor.App.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 额度监控">
    <Grid x:Name="WindowRoot" RowDefinitions="36,*">
        <Grid x:Name="TitleDragRegion" Background="Transparent" Margin="0,0,138,0">
            <TextBlock Text="CODEX  /  额度监控" FontSize="11" CharacterSpacing="70" Margin="20,0,0,0" VerticalAlignment="Center" Opacity="0.68" IsHitTestVisible="False" />
        </Grid>
        <Grid x:Name="Page" Grid.Row="1" Padding="18,4,18,16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="2">
                    <TextBlock Text="额度概览" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock x:Name="PlanText" Text="正在读取账户" FontSize="11" Opacity="0.68" />
                </StackPanel>
                <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" VerticalAlignment="Center" Click="RefreshButton_Click" Padding="13,7" />
            </Grid>
            <ScrollViewer x:Name="DetailsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid x:Name="DashboardColumns" RowDefinitions="Auto,Auto" RowSpacing="12" SizeChanged="DashboardColumns_SizeChanged">
                    <StackPanel x:Name="QuotaColumn" Spacing="12">
                        <Border x:Name="MainQuotaCard" Padding="16,14" CornerRadius="16" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock x:Name="MainWindowName" Text="当前额度窗口" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="QuotaStateText" Grid.Column="1" Text="等待数据" FontSize="11" Opacity="0.7" />
                                </Grid>
                                <TextBlock x:Name="RemainingText" Text="剩余 --" FontSize="32" FontWeight="SemiBold" />
                                <ProgressBar x:Name="QuotaProgress" Minimum="0" Maximum="100" Height="7" />
                                <TextBlock x:Name="RestrictionText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Grid x:Name="TimeCards" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <Border x:Name="ResetTimingCard" Padding="13" CornerRadius="16" BorderThickness="1">
                                <StackPanel Spacing="8" VerticalAlignment="Center">
                                    <TextBlock x:Name="MainResetTitle" Text="5 小时重置" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="ResetCountdownText" Text="重置时间未知" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="MainResetProgress" Minimum="0" Maximum="100" Height="6" />
                                    <TextBlock x:Name="ResetLocalText" Text="自然重置时间未知" FontSize="11" TextWrapping="Wrap" />
                                    <Button x:Name="CopyResetButton" Content="复制时间" Padding="8,3" FontSize="10" Click="CopyResetButton_Click" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="WeekTimingCard" Grid.Column="1" Padding="13" CornerRadius="16" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="周额度重置" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="WeeklyCountdownText" Text="周重置时间未知" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="WeeklyResetProgress" Minimum="0" Maximum="100" Height="6" />
                                    <TextBlock x:Name="WeeklyResetDateText" Text="等待周额度数据" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock x:Name="WeeklyRemainingText" FontSize="11" Opacity="0.7" />
                                    <Button x:Name="CopyWeeklyResetButton" Content="复制时间" Padding="8,3" FontSize="10" Click="CopyWeeklyResetButton_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel x:Name="OtherWindowsSection" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="其他额度窗口" FontSize="13" FontWeight="SemiBold" />
                            <StackPanel x:Name="OtherWindowsList" Spacing="8" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="CreditsCard" Grid.Row="1" Padding="16,14" CornerRadius="16" BorderThickness="1">
                        <StackPanel Spacing="9">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="重置卡" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="CreditsCountText" Grid.Column="1" Text="数量未知" FontSize="20" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock x:Name="CreditsStatusText" Text="到期详情暂不可用" FontSize="11" Opacity="0.66" TextWrapping="Wrap" />
                            <StackPanel x:Name="CreditsList" Spacing="8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="LastUpdateText" Text="尚未成功更新" FontSize="11" />
                    <TextBlock x:Name="ConnectionText" Text="尚未连接 Codex" FontSize="10" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="SettingsButton" Grid.Column="1" Content="外观与位置" VerticalAlignment="Center" Click="SettingsButton_Click" Padding="10,7" FontSize="12" />
            </Grid>
        </Grid>
    </Grid>
</Window>
